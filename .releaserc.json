{
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "type": "feat", "release": "minor" },
          { "type": "fix", "release": "patch" },
          { "type": "docs", "release": "patch" },
          { "type": "style", "release": "patch" },
          { "type": "refactor", "release": "patch" },
          { "type": "perf", "release": "patch" }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "새 기능", "hidden": false },
            { "type": "fix", "section": "버그 수정", "hidden": false },
            { "type": "docs", "section": "문서 변경", "hidden": false },
            { "type": "style", "section": "스타일", "hidden": false },
            { "type": "refactor", "section": "리팩토링", "hidden": false },
            { "type": "perf", "section": "성능 개선", "hidden": false },
            { "type": "chore", "section": "기타", "hidden": true },
            { "type": "ci", "section": "CI/CD", "hidden": true },
            { "type": "test", "section": "테스트", "hidden": true }
          ]
        }
      }
    ],
    "@semantic-release/github"
  ]
}
